{
  "compilerOptions": {
    "target": "ES2017",
    "allowArbitraryExtensions": true,
    "types": ["msw", "jest", "node", "@testing-library/jest-dom"],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
       "@mocks/*": ["./mocks/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "babel.config.js",
    "jest.setup.js",
    "src/**/*.test.ts", 
    "src/**/*.test.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
